#!/bin/sh
# platine-diction [marche|arret|bascule|etat|lire] : lecture de la sélection PRIMARY.
P=${XDG_RUNTIME_DIR:-/tmp}/platine-diction.pid

actif() { [ -f "$P" ] && kill -0 "$(cat "$P")" 2>/dev/null; }

reglage() {
    R=$HOME/.config/platine/reglages
    T=$R.tmp.$$
    mkdir -p "$HOME/.config/platine" || return
    [ -f "$R" ] || : >"$R"
    awk -v v="$1" '$1 != "diction" { print } END { print "diction " v }' \
        "$R" >"$T" && mv -f "$T" "$R"
}

case ${1:-bascule} in
etat)
    actif && echo marche || echo arret
    ;;
marche)
    actif && exit 0
    (
        ancien=$(xclip -o -selection primary 2>/dev/null)
        while sleep 0.7; do
            t=$(xclip -o -selection primary 2>/dev/null | head -c 2000)
            if [ -n "$t" ] && [ "$t" != "$ancien" ]; then
                ancien=$t
                pkill -u "$(id -u)" -x espeak-ng 2>/dev/null
                printf '%s' "$t" | espeak-ng -v fr -s 155 >/dev/null 2>&1 &
            fi
        done
    ) &
    echo $! >"$P"
    reglage 1
    espeak-ng -v fr "Diction activée" >/dev/null 2>&1 &
    ;;
arret)
    actif && kill "$(cat "$P")"
    rm -f "$P"
    pkill -u "$(id -u)" -x espeak-ng 2>/dev/null
    reglage 0
    ;;
lire)
    xclip -o -selection primary 2>/dev/null | head -c 2000 |
        espeak-ng -v fr -s 155
    ;;
bascule)
    if actif; then
        "$0" arret
        espeak-ng -v fr "Diction désactivée" >/dev/null 2>&1 &
    else
        "$0" marche
    fi
    ;;
esac
